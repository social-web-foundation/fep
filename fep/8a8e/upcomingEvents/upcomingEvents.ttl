@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/fep/8a8e/upcomingEvents> a owl:ObjectProperty ;
	rdfs:label "Collection of upcoming Events"@en ;
	rdfs:comment "An ActivityStreams Collection of Event objects that have a startTime property in the future."@en ;
	rdfs:isDefinedBy <https://w3id.org/fep/8a8e> .