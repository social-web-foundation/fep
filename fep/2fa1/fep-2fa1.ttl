@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/fep/2fa1#Form> a skos:ConceptScheme ;
	rdfs:label "Form"@en ;
	rdfs:comment "A scheme of categories that say what kind of thing an object is within its own object type, such as a concert or a workshop for an event, or a documentary or a tutorial for a video. It contains no categories defined by this FEP; a category states its membership with inScheme."@en ;
	rdfs:isDefinedBy <https://w3id.org/fep/2fa1> .

<https://w3id.org/fep/2fa1#Topic> a skos:ConceptScheme ;
	rdfs:label "Topic"@en ;
	rdfs:comment "A scheme of categories that say what an object is about: its subject matter. It contains no categories defined by this FEP; a category states its membership with inScheme."@en ;
	rdfs:isDefinedBy <https://w3id.org/fep/2fa1> .

<https://w3id.org/fep/2fa1> a owl:Ontology ;
	dc:creator "André Menrath <andre.menrath@posteo.de>" ;
	dc:rights "CC0 1.0 Universal (CC0 1.0) Public Domain Dedication"@en ;
	dcterms:abstract "An object can list its categories as Category objects within tag. Such a category has a stable IRI and can relate to an equivalent or a similar category in another vocabulary, allowing applications that use different category vocabularies to map and interpret classifications in federation." ;
	dcterms:dateSubmitted "2026-09-30"^^xsd:date ;
	dcterms:identifier "https://w3id.org/fep/2fa1"^^xsd:anyURI ;
	dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
	dcterms:title "FEP-2fa1: Federated Categories" .

